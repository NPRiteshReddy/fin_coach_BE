# ===================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===================================
# Copy these to Railway Dashboard → Variables tab
# DO NOT commit this file with actual values!

# ===================================
# DATABASE (Supabase)
# ===================================
DATABASE_URL="your-supabase-connection-string-here"

# ===================================
# JWT AUTHENTICATION
# ===================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-64-char-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=3000
NODE_ENV="production"

# ===================================
# GROQ API (AI Coach)
# ===================================
GROQ_API_KEY="your-groq-api-key-here"

# ===================================
# ALPHA VANTAGE API (Stock Prices)
# ===================================
ALPHA_VANTAGE_API_KEY="your-alpha-vantage-key-here"

# ===================================
# CORS CONFIGURATION
# ===================================
# UPDATE THIS after frontend is deployed to Vercel
FRONTEND_URL="http://localhost:5174"

# ===================================
# EMAIL CONFIGURATION (Gmail)
# ===================================
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password-here"
